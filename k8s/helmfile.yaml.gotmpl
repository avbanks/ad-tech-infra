# Fleet HUB only. Member clusters are Flux-managed (k8s/base + k8s/waves); hubs can't run Flux controllers,
# so the cross-cutting baseline (CRP) is still pushed here by scripts/deploy-k8s.sh.
#   helmfile -e dev --state-values-set continent=na apply
environments:
  dev:
    values:
      - environments/dev.yaml
---
helmDefaults:
  wait: true
  timeout: 600
  createNamespace: true
  atomic: false

{{- if not .StateValues.continent }}
{{-   fail "continent is required (--state-values-set continent=na)" }}
{{- end }}

releases:
  - name: fleet-baseline
    namespace: fleet-system
    chart: ./charts/fleet-baseline
    labels: { tier: hub }
    disableValidationOnInstall: true
    values:
      - environment: {{ .Values.environment }}
        continent: {{ .StateValues.continent | quote }}
